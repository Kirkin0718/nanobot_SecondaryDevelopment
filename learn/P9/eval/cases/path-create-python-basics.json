{
  "id": "path-create-python-basics",
  "prompt": "我想 4 周学完 Python 基础，帮我建学习路径",
  "tags": ["path"],
  "setup": {
    "goals/active.md": "# Active goals\n\n(none yet)\n"
  },
  "script": [
    {"op": "ensure_dir", "path": "learning/python-basics"},
    {
      "op": "write_file",
      "path": "learning/python-basics/path.md",
      "content": "# Python basics\n\n## 当前进度\n- 阶段：第 1 / 4 周\n\n## Today\n- [ ] 安装解释器说明（不自动安装）\n"
    },
    {
      "op": "write_file",
      "path": "goals/active.md",
      "content": "# Active goals\n\n1. **python-basics** — 4 周 Python 基础\n"
    },
    {"op": "record_tool", "name": "write_file"},
    {"op": "record_tool", "name": "long_task"}
  ],
  "expect": {
    "files_contain": [
      {"path": "learning/python-basics/path.md", "text": "当前进度"},
      {"path": "goals/active.md", "text": "python-basics"}
    ],
    "tools_used": ["write_file", "long_task"]
  },
  "failure_type_on_fail": "wrong_file",
  "live": true,
  "live_expect": {
    "any_file_contains": [
      {"glob": "learning/*/path.md", "text": "Python"},
      {"glob": "goals/active.md", "text": "Python"}
    ]
  }
}
